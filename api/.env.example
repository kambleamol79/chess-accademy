APP_ENV=development
APP_DEBUG=true
# Subdirectory deploy (Hostinger): APP_BASE_PATH=/brainstorm
APP_BASE_PATH=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chess_academy
DB_USER=root
# Required if MySQL root uses a password (same as mysql -u root -p)
# Quote passwords that contain # or spaces
DB_PASS="your_mysql_password_here"

CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200
CORS_ALLOW_LOCAL_DEV=true

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_TTL=3600
JWT_REFRESH_TTL_DAYS=30

# Optional live match WebSocket (cd api/realtime && npm i && node ws-server.mjs)
LIVE_WS_ENABLED=false
LIVE_WS_BROADCAST_URL=http://127.0.0.1:8091/broadcast
LIVE_WS_INTERNAL_SECRET=change-me-live-ws-secret
# Minutes added to match time control before cron auto-resigns idle games (default 10)
LIVE_MATCH_IDLE_GRACE_MINUTES=10

# Firebase Cloud Messaging (download service account JSON from Firebase console)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_STUDENTS_TOPIC=students

